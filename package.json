{
  "name": "switchyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "switchyard": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./capabilities": "./src/capabilities/index.ts",
    "./cli": "./src/cli.ts",
    "./commands": "./src/commands/index.ts",
    "./config": "./src/config/index.ts",
    "./discovery": "./src/discovery/index.ts",
    "./harness": "./src/harness/index.ts",
    "./output": "./src/output/index.ts",
    "./verification": "./src/verification/index.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:docs": "node --test tests/documentation-governance.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "types": "./src/index.ts",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
